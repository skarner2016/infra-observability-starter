# 镜像版本(按需调整)
COMPOSE_PROJECT_NAME=infra-observability-starter
PROMETHEUS_VERSION=v2.54.1
GRAFANA_VERSION=11.2.0
LOKI_VERSION=3.2.1
ALLOY_VERSION=v1.4.2
NODE_EXPORTER_VERSION=v1.8.2
NGINX_VERSION=1.27-alpine
NGINX_EXPORTER_VERSION=1.3.0
CADDY_VERSION=2.8-alpine

# Grafana 管理员凭据(演示默认值,启动后请修改)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus 数据保留
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB

# 宿主机端口映射(冲突时在此调整)
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_OTLP_HTTP_PORT=4318
DEMO_WEB_PORT=8080
PROXY_PORT=8088

# rootless 适配
# ROOTLESS:1 表示运行在 rootless Docker 下(仅作标识与文档用途)
ROOTLESS=0
# docker.sock 路径;rootless 环境改为 $XDG_RUNTIME_DIR/docker.sock
# 示例:DOCKER_SOCKET=/run/user/1000/docker.sock
DOCKER_SOCKET=/var/run/docker.sock
# docker 数据目录;rootless 环境改为用户目录(如 /home/user/.local/share/docker)
# 供 Alloy 内嵌 cAdvisor 读取镜像层信息
DOCKER_DATA_ROOT=/var/lib/docker
